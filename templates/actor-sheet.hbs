<div class="sheet-content">
<header class="dossier-header"><img src="{{actor.img}}" alt="" width="72" height="72"><div><span class="eyebrow">{{actor.type}} dossier · {{side}}</span><input class="name-input" name="name" value="{{actor.name}}" aria-label="Name" {{#unless editable}}disabled{{/unless}}>{{#if parent}}<small>Assigned to {{parent.name}}</small>{{/if}}</div><span class="insignia">BA</span></header>
{{#if isArmy}}<button type="button" data-action="checkRoster" {{#unless editable}}disabled{{/unless}}>Check roster</button><button type="button" data-action="spawn" {{#unless editable}}disabled{{/unless}}>Deploy force</button><button type="button" data-action="shareRoster" {{#unless editable}}disabled{{/unless}}>Copy roster ownership to all members (GM)</button><label>Force selector UUID<input name="system.selectorUuid" value="{{system.selectorUuid}}" {{#unless editable}}disabled{{/unless}}></label><div class="stat-strip"><label>Points limit <input name="system.pointsLimit" type="number" value="{{system.pointsLimit}}" {{#unless editable}}disabled{{/unless}}></label><label>Faction UUID <input name="system.factionUuid" value="{{system.factionUuid}}" {{#unless editable}}disabled{{/unless}}></label><label>Side <input name="system.side" value="{{system.side}}" {{#unless editable}}disabled{{/unless}}></label></div>{{/if}}
{{#if isUnit}}
<div class="stat-strip"><div><b>{{living}}</b><span>Active soldiers</span></div><div><b>{{morale}}</b><span>Morale</span></div><div><b>{{damageValue}}+</b><span>Damage value</span></div><div><b>{{system.pins}}</b><span>Pin markers</span></div></div>
<div class="orders">{{#each orders}}<button type="button" data-action="order" data-order="{{order}}" class="order-button {{#if active}}active{{/if}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button>{{/each}}</div>
<div class="toolbar"><button type="button" data-action="pin" data-delta="-1" {{#unless editable}}disabled{{/unless}}>− Pin</button><button type="button" data-action="pin" data-delta="1" {{#unless editable}}disabled{{/unless}}>+ Pin</button><button type="button" data-action="morale" {{#unless editable}}disabled{{/unless}}>Morale test</button><button type="button" data-action="activate" {{#unless editable}}disabled{{/unless}}>Activate</button><button type="button" data-action="retain" {{#unless editable}}disabled{{/unless}}>Retain order</button></div>
<div class="combat-actions"><button type="button" class="primary" data-action="shoot" {{#unless editable}}disabled{{/unless}}>Resolve shooting</button><button type="button" data-action="assault" {{#unless editable}}disabled{{/unless}}>Close quarters</button><button type="button" data-action="spawn" {{#unless editable}}disabled{{/unless}}>Deploy soldiers</button></div>
<details><summary>Unit configuration</summary><div class="field-grid"><label>Experience<select name="system.quality" {{#unless editable}}disabled{{/unless}}>{{#each qualities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><label>Unit kind<select name="system.kind" {{#unless editable}}disabled{{/unless}}>{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><label>Side<input name="system.side" value="{{system.side}}" {{#unless editable}}disabled{{/unless}}></label><label>Selector role<input name="system.battlefieldRole" value="{{system.battlefieldRole}}" {{#unless editable}}disabled{{/unless}}></label><label>Faction UUID<input name="system.factionUuid" value="{{system.factionUuid}}" {{#unless editable}}disabled{{/unless}}></label><label>Points<input type="number" name="system.points" value="{{system.points}}" {{#unless editable}}disabled{{/unless}}></label><label>Starting size<input type="number" name="system.startingSize" value="{{system.startingSize}}" {{#unless editable}}disabled{{/unless}}></label><label>Maximum size<input type="number" name="system.maxSize" value="{{system.maxSize}}" {{#unless editable}}disabled{{/unless}}></label><label>Morale bonus<input type="number" name="system.moraleBonus" value="{{system.moraleBonus}}" {{#unless editable}}disabled{{/unless}}></label><label>Vehicle damage state<input name="system.vehicleDamage" value="{{system.vehicleDamage}}" {{#unless editable}}disabled{{/unless}}></label><label>Vehicle damage value<input type="number" name="system.damageValue" value="{{system.damageValue}}" {{#unless editable}}disabled{{/unless}}></label><label>Advance (inches)<input type="number" name="system.moveAdvance" value="{{system.moveAdvance}}" {{#unless editable}}disabled{{/unless}}></label><label>Run (inches)<input type="number" name="system.moveRun" value="{{system.moveRun}}" {{#unless editable}}disabled{{/unless}}></label><label>Transport capacity<input type="number" name="system.capacity" value="{{system.capacity}}" {{#unless editable}}disabled{{/unless}}></label><label><input type="checkbox" name="system.immobilised" {{checked system.immobilised}} {{#unless editable}}disabled{{/unless}}> Immobilised</label><label><input type="checkbox" name="system.openTopped" {{checked system.openTopped}} {{#unless editable}}disabled{{/unless}}> Open topped</label><label><input type="checkbox" name="system.ncoAlive" {{checked system.ncoAlive}} {{#unless editable}}disabled{{/unless}}> NCO alive</label><label><input type="checkbox" name="system.fullStrength" {{checked system.fullStrength}} {{#unless editable}}disabled{{/unless}}> Full strength bonus</label></div><div class="toolbar"><button type="button" data-action="transport" {{#unless editable}}disabled{{/unless}}>Embark transport</button><button type="button" data-action="unload" {{#unless editable}}disabled{{/unless}}>Disembark</button></div><small>Transport: {{system.transportUuid}}</small><div class="section-heading"><h3>Unit traits</h3><button type="button" data-action="editTraits" {{#unless editable}}disabled{{/unless}}>Edit references</button></div>{{#each system.traitUuids}}<p class="muted">{{this}}</p>{{/each}}</details>
<details><summary>Adjudication · manual corrections</summary><p class="advisory">Use these overrides for a manually resolved result or a referee correction.</p><div class="field-grid"><label>Current order<select name="system.order" {{#unless editable}}disabled{{/unless}}>{{#each manualOrders}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label><input type="checkbox" name="system.activated" {{checked system.activated}} {{#unless editable}}disabled{{/unless}}> Order already received</label><label><input type="checkbox" name="system.destroyed" {{checked system.destroyed}} {{#unless editable}}disabled{{/unless}}> Destroyed</label><label><input type="checkbox" name="system.retained" {{checked system.retained}} {{#unless editable}}disabled{{/unless}}> Retain order next round</label></div></details>
{{/if}}
{{#if isModel}}<div class="field-grid"><label>Role<input name="system.role" value="{{system.role}}" {{#unless editable}}disabled{{/unless}}></label><label>Experience<select name="system.quality" {{#unless editable}}disabled{{/unless}}>{{#each qualities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label></div><button type="button" data-action="casualty" {{#unless editable}}disabled{{/unless}}>{{#if system.dead}}Restore soldier{{else}}Mark casualty{{/if}}</button>{{/if}}
{{#unless isModel}}<section><div class="section-heading"><h3>{{#if isArmy}}Army roster{{else}}Soldier roster{{/if}}</h3><div>{{#if isUnit}}<button type="button" data-action="addModels" {{#unless editable}}disabled{{/unless}}>+ Soldiers</button>{{/if}}<button type="button" data-action="linkMember" {{#unless editable}}disabled{{/unless}}>Link actor</button></div></div><div class="roster">{{#each members}}<div class="roster-row {{#if dead}}casualty{{/if}}"><img src="{{img}}" alt="" width="36" height="36"><button type="button" class="text-button" data-action="openMember" data-uuid="{{uuid}}">{{name}}</button><span class="muted">{{quality}} {{#if dead}}· casualty{{/if}}</span>{{#if ../isUnit}}<button type="button" data-action="casualty" data-uuid="{{uuid}}" {{#unless ../editable}}disabled{{/unless}}>{{#if dead}}Restore{{else}}Casualty{{/if}}</button>{{/if}}<button type="button" data-action="removeMember" data-uuid="{{uuid}}" aria-label="Unlink {{name}}" {{#unless ../editable}}disabled{{/unless}}>×</button></div>{{else}}<p class="empty-state">No members assigned. Link an actor{{#if isUnit}} or add soldiers{{/if}} to assemble this roster.</p>{{/each}}</div></section>{{/unless}}
{{#unless isArmy}}<section><div class="section-heading"><h3>Weapons & equipment</h3><button type="button" data-action="addWeapon" {{#unless editable}}disabled{{/unless}}>+ Weapon</button></div>{{#each weapons}}<div class="weapon-row"><button type="button" class="text-button" data-action="openItem" data-id="{{id}}">{{name}}</button><span>{{system.range}}″</span><span>{{system.shots}} shots</span><span>Pen {{system.penetration}}</span></div>{{else}}<p class="empty-state">No weapons on this actor. Soldier weapons contribute to the parent unit automatically.</p>{{/each}}</section>{{/unless}}
{{#if profileSummary}}<section><h3>Roster profile</h3><p>{{profileSummary}}</p>{{#each upgrades}}<p><b>{{name}}</b> · {{details}}</p>{{/each}}<small>Upgrade limits, loaders, costs and eligibility require manual confirmation.</small></section>{{/if}}{{#if factionName}}<p class="eyebrow">Faction · {{factionName}}</p>{{/if}}{{#if ruleProfiles}}<section><h3>Inherited & personal rules</h3>{{#each ruleProfiles}}<details><summary><button type="button" class="text-button" data-action="openProfile" data-uuid="{{uuid}}">{{name}}</button></summary><p>{{effect}}</p><p>{{notes}}</p></details>{{/each}}<small>These linked rules require manual adjudication.</small></section>{{/if}}<label class="notes-label">Field notes<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label>
</div>
