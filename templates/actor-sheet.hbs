<div class="boltaction ba-sheet standard-form {{#if isArmyBuilder}}ba-builder{{/if}}" style="--ba-faction-color:{{factionColor}};display:flex;flex-direction:column;gap:12px;padding:16px;overflow-y:auto;min-height:0;">
  <header class="ba-sheet-header" style="display:flex;align-items:center;gap:12px;border-bottom:2px solid var(--ba-faction-color);padding-bottom:10px;">
    <img src="{{actor.img}}" alt="" width="56" height="56">
    <div class="ba-title" style="flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;">
      <small>{{kindLabel}}{{#if isModel}} · {{profileName}}{{/if}}{{#if isSquad}} · {{profileName}}{{/if}}{{#if isNco}} <span title="NCO" aria-label="NCO">★</span>{{/if}}</small>
      {{#if isSquad}}<label>Identity<input name="system.identity" value="{{squadIdentity}}" placeholder="Unnamed Squad" aria-label="Squad identity" {{#unless editable}}disabled{{/unless}}></label>
      {{else}}<label>{{#if isModel}}Identity{{else}}Name{{/if}}<input name="name" value="{{actor.name}}" placeholder="Unnamed Soldier" aria-label="{{#if isModel}}Identity{{else}}Name{{/if}}" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
      {{#if parent}}<small>In {{parent.name}}</small>{{/if}}
    </div>
  </header>
  {{#if cost}}<section class="ba-cost-card" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:10px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 45%,transparent);border-radius:6px;"><strong>{{cost.total}} points</strong><small>Base {{cost.base}} · Options {{cost.options}}</small>{{#if costUnknown}}<ul style="flex-basis:100%;margin:0;">{{#each costUnknown}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</section>{{/if}}

  {{#if isTeam}}
  {{#if isArmyBuilder}}<label>Army points limit<input type="number" name="system.pointsLimit" min="1" step="1" value="{{system.pointsLimit}}" {{#unless editable}}disabled{{/unless}}></label>
  <div class="ba-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">
    <div class="ba-detail"><label>Faction</label><strong>{{factionName}}</strong>{{#if editable}}<button type="button" data-action="chooseFaction">Choose faction</button>{{/if}}</div>
    <div class="ba-detail"><label>Ownership</label><p>Use Foundry’s ownership settings to give players control of this army.</p></div>
  </div>
  <div class="ba-builder-workspace"><aside class="ba-card ba-orbat-tree"><h2>Order of battle</h2><p>Generic reinforced platoon · p.153</p>{{#each orbatPlatoons}}<section class="ba-platoon-branch"><h3>▱ {{name}}</h3><p class="ba-prerequisite">{{#if commanderPresent}}✓ Lieutenant assigned{{else}}⚠ Lieutenant required{{/if}}</p><div class="ba-orbat-children">{{#each squads}}<button type="button" data-action="selectBuilderSquad" data-uuid="{{uuid}}" aria-pressed="{{selected}}"><span>▭ {{name}}</span>{{#if cost}}<b>{{cost.total}} pts</b>{{/if}}</button>{{else}}<p>No squads assigned.</p>{{/each}}</div><button type="button" data-action="browseProfiles" data-platoon-id="{{id}}">+ Add under this commander</button>{{#each issues}}<small class="ba-orbat-issue">{{this}}</small>{{/each}}</section>{{/each}}<button type="button" data-action="addPlatoon">+ Add platoon</button><button type="button" data-action="browseProfiles">Browse faction profiles</button></aside><main class="ba-builder-config">{{#if showBuilderCatalogue}}<section class="ba-card ba-catalogue-panel"><h2>{{factionName}} · Available profiles</h2><p>1. Add a profile. 2. Expand its squad card. 3. Choose experience, models and equipment. Option prices are shown beside each choice.</p>
    <label>Profile category<select data-catalogue-category><option value="">All categories</option>{{#each catalogueGroups}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label><label>Find a squad or vehicle<input type="search" data-catalogue-search placeholder="Search available profiles"></label>
    {{#each catalogueGroups}}<details open data-catalogue-group><summary>{{label}} <small>({{entries.length}})</small></summary><div class="ba-catalogue-grid">{{#each entries}}<article data-catalogue-entry data-kind="{{kind}}" class="ba-profile-card" style="border:1px solid color-mix(in srgb,var(--ba-faction-color) 30%,transparent);border-radius:5px;padding:10px;"><div class="ba-profile-title"><strong>{{name}}</strong><b class="ba-price">{{baseCostLabel}}</b></div><small style="display:block;">{{quality}} · {{baseModels}} models{{#if extraModelCostLabel}} · Extra model {{extraModelCostLabel}}{{else}}{{#if extraModelCost}} · Extra model {{extraModelCost}} pts{{/if}}{{/if}}{{#if sourcePage}} · p. {{sourcePage}}{{/if}}</small>{{#if ../../editable}}<button type="button" data-action="addArmySquad" data-slug="{{slug}}">Add to army</button>{{/if}}{{#if options}}<details><summary>Profile options</summary><ul>{{#each options}}<li>{{label}}{{#if referenceUuid}} <button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}" title="Inspect rule reference">ⓘ</button>{{/if}}{{#if costLabel}} · {{costLabel}}{{else}}{{#if cost}} · {{cost}} pts{{/if}}{{/if}}</li>{{/each}}</ul></details>{{/if}}</article>{{/each}}</div></details>{{else}}<p>Choose a faction to see its available profiles.</p>{{/each}}
  </section>{{else}}  <section class="ba-card ba-army-roster"><h2>Configure selected squad</h2><p>Buy additional models, then equip existing soldiers. A gunner and loader are members of the purchased squad, not additional free models.</p>
    {{#each selectedArmySquads}}<details open class="ba-army-squad" data-builder-squad="{{uuid}}"><summary><strong>{{name}}</strong>{{#if cost}} · {{cost.total}} points{{/if}}</summary>
      <section class="ba-strength-card"><h3>Purchased strength · {{modelCount}} models</h3><p>{{ncoCount}} NCO + {{soldierCount}} other models{{#if minimum}} · Minimum {{minimum}}{{/if}}{{#if maximum}} · Maximum {{maximum}}{{/if}}</p><div class="ba-strength-controls"><button type="button" data-action="removeLastModel" data-squad-uuid="{{uuid}}">− Remove model</button><strong>{{modelCount}}</strong><button type="button" data-action="addModel" data-squad-uuid="{{uuid}}">+ Buy model{{#if extraModelCost}} · {{extraModelCost}} pts{{/if}}</button></div><p>{{weaponSummary}}</p><small>Adding a model also recalculates per-model squad upgrades. Removing an equipped model removes its purchased equipment.</small></section>
      <label>Platoon assignment<select data-builder-platoon data-squad-uuid="{{uuid}}">{{#each platoonOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <div class="ba-grid" style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;margin:10px 0;">
        <label>Squad identity<input data-builder-identity data-squad-uuid="{{uuid}}" value="{{identity}}" {{#unless editable}}disabled{{/unless}}></label>
        {{#if allowanceLabel}}<label class="ba-checkbox"><input type="checkbox" data-national-allowance data-squad-uuid="{{uuid}}" {{checked nationalAllowance}} {{#unless editable}}disabled{{/unless}}> {{allowanceLabel}}</label>{{/if}}<div><label>Source experience</label>{{#each qualities}}{{#if selected}}<strong>{{label}}</strong>{{/if}}{{/each}}<small>Choose another source profile to change infantry tier.</small></div>
        <label>Pins<input type="number" min="0" max="100" data-pins data-squad-uuid="{{uuid}}" value="{{pins}}" {{#unless editable}}disabled{{/unless}}></label>
      </div>
      <div style="display:flex;gap:8px;margin-bottom:10px;"><button type="button" data-action="openMember" data-uuid="{{uuid}}">Open squad</button>{{#if editable}}<button type="button" data-action="addModel" data-squad-uuid="{{uuid}}">Add model{{#if extraModelCost}} (+{{extraModelCost}} pts){{/if}}</button><button type="button" data-action="rollAttack" data-squad-uuid="{{uuid}}">Roll squad attack</button><button type="button" data-action="removeMember" data-uuid="{{uuid}}" title="Unlink; Shift-click to delete">Remove squad</button>{{/if}}</div>
    <section class="ba-loadout"><h3>Equipment &amp; assignments</h3><p>Swap weapons on existing models. Assign another purchased model as loader for each team weapon; the loader is not a free additional soldier.</p><div class="ba-loadout-grid"><strong>Model</strong><strong>Primary weapons</strong><strong>Roles / upgrades</strong>{{#each members}}<div>{{name}}</div><div>{{#each primarySlots}}<label>{{label}}<select data-roster-primary data-model-uuid="{{../uuid}}">{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/each}}</div><div>{{#if isInfantry}}<label class="ba-checkbox"><input type="checkbox" data-model-flag="isLoader" data-model-uuid="{{uuid}}" {{checked isLoader}}> Loader</label>{{/if}}{{#each optionalChoices}}<label class="ba-checkbox"><input type="checkbox" data-roster-option data-model-uuid="{{../uuid}}" data-choice-id="{{id}}" {{checked selected}}> {{label}} · {{costLabel}}</label>{{#if limitLabel}}<small>{{limitLabel}}</small>{{/if}}{{/each}}</div>{{/each}}</div></section>
    <details class="ba-model-assignments"><summary>Individual models · identities, weapons and role assignments</summary><div class="ba-roster-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;">
    {{#each members}}<article data-roster-card="{{uuid}}" class="ba-roster-card {{#if dead}}ba-casualty{{/if}}" style="display:flex;flex-direction:column;gap:8px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 40%,transparent);border-radius:6px;padding:10px;">
      <div style="display:flex;align-items:center;gap:8px;"><img src="{{img}}" alt="" width="36" height="36"><label style="flex:1;min-width:0;">Identity<input data-model-identity data-model-uuid="{{uuid}}" value="{{name}}" {{#unless ../editable}}disabled{{/unless}}></label>{{#if uuid}}<button type="button" data-action="openMember" data-uuid="{{uuid}}" title="Open model summary" style="width:30px;">↗</button>{{/if}}{{#if ../editable}}<button type="button" data-action="deleteModel" data-uuid="{{uuid}}" title="Delete model" aria-label="Delete {{name}}" style="width:30px;">×</button>{{/if}}</div>
      <small>{{type}}</small>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
      {{#if isInfantry}}<label class="ba-checkbox"><input type="checkbox" data-model-flag="isNco" data-model-uuid="{{uuid}}" {{checked isNco}} {{#unless ../editable}}disabled{{/unless}}> NCO ★</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isLoader" data-model-uuid="{{uuid}}" {{checked isLoader}} {{#unless ../editable}}disabled{{/unless}}> Loader</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isMedic" data-model-uuid="{{uuid}}" {{checked isMedic}} {{#unless ../editable}}disabled{{/unless}}> Medic</label>{{/if}}
      <label class="ba-checkbox"><input type="checkbox" data-model-flag="dead" data-model-uuid="{{uuid}}" {{checked dead}} {{#unless ../editable}}disabled{{/unless}}> Casualty</label></div>
      {{#each primarySlots}}<label>{{label}}<select data-roster-primary data-model-uuid="{{../uuid}}" {{#unless ../../editable}}disabled{{/unless}}>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><details class="ba-choice-references"><summary>Inspect available {{label}} options</summary>{{#each choices}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">{{label}} ↗</button>{{/if}}{{/each}}</details>{{/each}}
      {{#each optionalChoices}}<label class="ba-checkbox"><input type="checkbox" data-roster-option data-model-uuid="{{../uuid}}" data-choice-id="{{id}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}{{#if costLabel}} · {{costLabel}}{{/if}}</label>{{#if limitLabel}}<small class="ba-option-limit">{{limitLabel}}</small>{{/if}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">Inspect {{label}}</button>{{/if}}{{/each}}
      {{#if isVehicle}}<details><summary>Vehicle status</summary><div style="display:flex;flex-wrap:wrap;gap:8px;">{{#each vehicleStates}}<label class="ba-checkbox"><input type="checkbox" data-vehicle-state="{{value}}" data-model-uuid="{{../uuid}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}{{#if costLabel}} · {{costLabel}}{{/if}}</label>{{#if limitLabel}}<small class="ba-option-limit">{{limitLabel}}</small>{{/if}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">Inspect {{label}}</button>{{/if}}{{/each}}</div></details>{{/if}}
      {{#if weaponReferences}}<details class="ba-equipped-references"><summary>Weapon profiles &amp; effects</summary>{{#each weaponReferences}}<div class="ba-weapon-reference"><button type="button" data-action="openReference" data-uuid="{{uuid}}">{{name}} ↗</button><small>Range {{range}}″ · Shots {{shots}} · Penetration {{penetration}}</small>{{#if traits}}<small>{{traits}}</small>{{/if}}</div>{{/each}}</details>{{/if}}
      {{#if manualOptions}}<details><summary>Other profile options</summary>{{#each manualOptions}}<p>{{label}} — {{reason}}</p>{{/each}}</details>{{/if}}
    </article>{{else}}<p>No models in this squad.</p>{{/each}}</div></details>
    </details>{{else}}<p>No squads in this army yet.</p>{{/each}}
    {{#if editable}}<button type="button" data-action="createSquad">Create empty squad</button><div class="ba-drop-zone" data-drop-target="squad">You can also drag an existing squad here.</div>{{/if}}
  </section>{{/if}}</main><aside class="ba-card ba-builder-summary"><h2>Army review</h2><div class="ba-budget"><strong>{{cost.total}} points</strong><span>{{builderRemaining}} points remaining</span></div><h3>Composition</h3>{{#if legalityPassed}}<p>✓ Legal under implemented checks</p>{{else}}<p>⚠ Composition needs attention</p>{{/if}}{{#each legalityErrors}}<p class="ba-orbat-issue">{{this}}</p>{{/each}}{{#each legalityWarnings}}<p>{{this}}</p>{{/each}}<p>Legality is advisory. Your army is saved as you edit, including incomplete or illegal compositions.</p><button type="button" data-action="finishBuilder">Finish and open Army</button></aside></div>
  {{else}}
  <section class="ba-card"><h2>Army overview</h2><p><strong>{{factionName}}</strong> · {{squadCount}} squads · {{modelCount}} models</p><button type="button" data-action="openArmyBuilder">Open Army Builder</button><p>Build squads, choose equipment, and review army legality in the dedicated builder.</p>
    {{#each members}}<button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}} · {{count}} models</button>{{else}}<p>No squads yet.</p>{{/each}}
  </section>
  {{/if}}
  {{#if legality}}<section class="ba-card ba-legality"><h2>Army legality checks</h2>{{#if legalityPassed}}<p>No errors reported by the implemented checks.</p>{{else}}<p>Needs review. Unverified costs or incomplete source data prevent a complete result.</p>{{/if}}{{#if legalityErrors}}<ul>{{#each legalityErrors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{#if legalityWarnings}}<details open><summary>Warnings and limitations</summary><ul>{{#each legalityWarnings}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}</section>{{/if}}
  {{/if}}
  {{#if isSquad}}
  <div class="ba-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;">
    <label>Squad type<select data-squad-kind {{#unless editable}}disabled{{/unless}}>{{#each squadKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    {{#if allowanceLabel}}<label class="ba-checkbox"><input type="checkbox" name="system.nationalAllowance" {{checked system.nationalAllowance}} {{#unless editable}}disabled{{/unless}}> {{allowanceLabel}}</label>{{/if}}<label>Experience<select data-squad-experience {{#unless editable}}disabled{{/unless}}>{{#each squadQualities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Pins<input data-pins type="number" min="0" max="100" step="1" value="{{system.pins}}" {{#unless editable}}disabled{{/unless}}></label>
  </div>
  <section class="ba-card ba-action-state"><h2>Action state</h2><p>{{actionState}} · Order: {{system.order}}{{#if system.movementTaken}} · Movement completed{{/if}}</p><button type="button" data-action="markMovement">Mark movement completed</button><button type="button" data-action="checkMorale">Morale test</button>{{#if isGM}}<button type="button" data-action="resetAction">Reset this squad</button><button type="button" data-action="nextBattleRound">Next battle round</button>{{/if}}<div style="display:flex;flex-wrap:wrap;gap:6px;">{{#each orders}}<button type="button" data-action="issueOrder" data-order="{{value}}" aria-pressed="{{selected}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button>{{/each}}</div></section>
  {{#if editable}}<button type="button" data-action="rollAttack"><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll squad attack</button>{{/if}}
  {{#if incompatible}}<p class="notification warning">This squad contains incompatible model types. Remove incompatible models before adding more.</p>{{/if}}
  <section class="ba-card"><div class="ba-section-heading"><h2>Roster ({{modelCount}} models)</h2>{{#if editable}}<button type="button" data-action="addModel">Add model{{#if extraModelCost}} (+{{extraModelCost}} pts){{/if}}</button>{{/if}}</div>
    {{#if sourceProfile.baseModels}}<p>Source profile: {{sourceProfile.baseModels}} starting models{{#if sourceProfile.maxModels}}, up to {{sourceProfile.maxModels}}{{/if}}. Source composition limits are checked by the Army Builder; review any warnings.</p>{{/if}}
    <div class="ba-roster-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;">
    {{#each members}}<article data-roster-card="{{uuid}}" class="ba-roster-card {{#if dead}}ba-casualty{{/if}}" style="display:flex;flex-direction:column;gap:8px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 40%,transparent);border-radius:6px;padding:10px;">
      <div style="display:flex;align-items:center;gap:8px;"><img src="{{img}}" alt="" width="36" height="36"><label style="flex:1;min-width:0;">Identity<input data-model-identity data-model-uuid="{{uuid}}" value="{{name}}" {{#unless ../editable}}disabled{{/unless}}></label>{{#if uuid}}<button type="button" data-action="openMember" data-uuid="{{uuid}}" title="Open model summary" style="width:30px;">↗</button>{{/if}}{{#if ../editable}}<button type="button" data-action="deleteModel" data-uuid="{{uuid}}" title="Delete model" aria-label="Delete {{name}}" style="width:30px;">×</button>{{/if}}</div>
      <small>{{type}}</small>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
      {{#if isInfantry}}<label class="ba-checkbox"><input type="checkbox" data-model-flag="isNco" data-model-uuid="{{uuid}}" {{checked isNco}} {{#unless ../editable}}disabled{{/unless}}> NCO ★</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isLoader" data-model-uuid="{{uuid}}" {{checked isLoader}} {{#unless ../editable}}disabled{{/unless}}> Loader</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isMedic" data-model-uuid="{{uuid}}" {{checked isMedic}} {{#unless ../editable}}disabled{{/unless}}> Medic</label>{{/if}}
      <label class="ba-checkbox"><input type="checkbox" data-model-flag="dead" data-model-uuid="{{uuid}}" {{checked dead}} {{#unless ../editable}}disabled{{/unless}}> Casualty</label></div>
      {{#each primarySlots}}<label>{{label}}<select data-roster-primary data-model-uuid="{{../uuid}}" {{#unless ../../editable}}disabled{{/unless}}>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><details class="ba-choice-references"><summary>Inspect available {{label}} options</summary>{{#each choices}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">{{label}} ↗</button>{{/if}}{{/each}}</details>{{/each}}
      {{#each optionalChoices}}<label class="ba-checkbox"><input type="checkbox" data-roster-option data-model-uuid="{{../uuid}}" data-choice-id="{{id}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}{{#if costLabel}} · {{costLabel}}{{/if}}</label>{{#if limitLabel}}<small class="ba-option-limit">{{limitLabel}}</small>{{/if}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">Inspect {{label}}</button>{{/if}}{{/each}}
      {{#if isVehicle}}<details><summary>Vehicle status</summary><div style="display:flex;flex-wrap:wrap;gap:8px;">{{#each vehicleStates}}<label class="ba-checkbox"><input type="checkbox" data-vehicle-state="{{value}}" data-model-uuid="{{../uuid}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}{{#if costLabel}} · {{costLabel}}{{/if}}</label>{{#if limitLabel}}<small class="ba-option-limit">{{limitLabel}}</small>{{/if}}{{#if referenceUuid}}<button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}">Inspect {{label}}</button>{{/if}}{{/each}}</div></details>{{/if}}
      {{#if weaponReferences}}<details class="ba-equipped-references"><summary>Weapon profiles &amp; effects</summary>{{#each weaponReferences}}<div class="ba-weapon-reference"><button type="button" data-action="openReference" data-uuid="{{uuid}}">{{name}} ↗</button><small>Range {{range}}″ · Shots {{shots}} · Penetration {{penetration}}</small>{{#if traits}}<small>{{traits}}</small>{{/if}}</div>{{/each}}</details>{{/if}}
      {{#if manualOptions}}<details><summary>Other profile options</summary>{{#each manualOptions}}<p>{{label}} — {{reason}}</p>{{/each}}</details>{{/if}}
    </article>{{else}}<p>No models in this squad.</p>{{/each}}</div>
    {{#if editable}}<div class="ba-drop-zone" data-drop-target="model">Drag a compendium model here to import it into this squad.</div>{{/if}}
  </section>
  {{#if sourceOptions}}<details><summary>Source profile options</summary><ul>{{#each sourceOptions}}<li>{{label}}{{#if referenceUuid}} <button type="button" class="ba-reference" data-action="openReference" data-uuid="{{referenceUuid}}" title="Inspect rule reference">ⓘ</button>{{/if}}{{#if costLabel}} · {{costLabel}}{{else}}{{#if cost}} · {{cost}} pts{{/if}}{{/if}}</li>{{/each}}</ul></details>{{/if}}
  {{/if}}
  {{#if isModel}}
  <section class="ba-card"><h2>Model summary</h2><p>{{actor.name}}{{#if isNco}} · NCO ★{{/if}}{{#if isLoader}} · Loader{{/if}}{{#if system.isMedic}} · Medic{{/if}}{{#if system.dead}} · Casualty{{/if}}</p>
    {{#each weapons}}<p><strong>{{name}}</strong> · {{range}}″ · {{shots}} shots · quantity {{quantity}}</p>{{else}}<p>No weapons equipped.</p>{{/each}}
    {{#if parent}}<button type="button" data-action="openSquad">Open squad builder</button>{{else}}<p>Import or link this model into a squad to customise it.</p>{{/if}}
  </section>
  {{/if}}
  {{#if ruleProfiles}}<section class="ba-traits-card" style="padding:12px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 45%,transparent);border-radius:6px;"><h2 style="font-size:1.1rem;line-height:1.3;margin:0 0 8px;">Traits</h2><div class="ba-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">{{#each ruleProfiles}}<article class="ba-trait-reference"><h3 style="font-size:1rem;margin:0;">{{name}}{{#if uuid}} <button type="button" class="ba-reference" data-action="openReference" data-uuid="{{uuid}}" title="Inspect trait reference">ⓘ</button>{{/if}}</h3><small>{{source}}</small><p>{{effect}}</p>{{#if notes}}<p>{{notes}}</p>{{/if}}</article>{{/each}}</div></section>{{/if}}
  <label>Notes<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label>
</div>
