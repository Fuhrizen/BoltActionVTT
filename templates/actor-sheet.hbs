<div class="boltaction ba-sheet standard-form" style="--ba-faction-color:{{factionColor}};display:flex;flex-direction:column;gap:12px;padding:16px;overflow-y:auto;min-height:0;">
  <header class="ba-sheet-header" style="display:flex;align-items:center;gap:12px;border-bottom:2px solid var(--ba-faction-color);padding-bottom:10px;">
    <img src="{{actor.img}}" alt="" width="56" height="56">
    <div class="ba-title" style="flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;">
      <small>{{kindLabel}}{{#if isModel}} · {{profileName}}{{/if}}{{#if isSquad}} · {{profileName}}{{/if}}{{#if isNco}} <span title="NCO" aria-label="NCO">★</span>{{/if}}</small>
      {{#if isSquad}}<label>Identity<input name="system.identity" value="{{squadIdentity}}" placeholder="Unnamed Squad" aria-label="Squad identity" {{#unless editable}}disabled{{/unless}}></label>
      {{else}}<label>{{#if isModel}}Identity{{else}}Name{{/if}}<input name="name" value="{{actor.name}}" placeholder="Unnamed Soldier" aria-label="{{#if isModel}}Identity{{else}}Name{{/if}}" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
      {{#if parent}}<small>In {{parent.name}}</small>{{/if}}
    </div>
  </header>
  {{#if cost}}<section class="ba-cost-card" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:10px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 45%,transparent);border-radius:6px;"><strong>{{cost.total}} points</strong><small>Base {{cost.base}} · Options {{cost.options}}</small>{{#if costUnknown}}<ul style="flex-basis:100%;margin:0;">{{#each costUnknown}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</section>{{/if}}

  {{#if isTeam}}
  <div class="ba-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">
    <div class="ba-detail"><label>Faction</label><strong>{{factionName}}</strong>{{#if editable}}<button type="button" data-action="chooseFaction">Choose faction</button>{{/if}}</div>
    <div class="ba-detail"><label>Ownership</label><p>Use Foundry’s ownership settings to give players control of this army.</p></div>
  </div>
  <section class="ba-card" style="display:flex;flex-direction:column;gap:10px;padding:12px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 45%,transparent);border-radius:6px;background:color-mix(in srgb,var(--ba-faction-color) 6%,transparent);">
    <div class="ba-section-heading" style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><h2 style="font-size:1.1rem;line-height:1.3;margin:0;">Squads ({{squadCount}})</h2>{{#if editable}}<button type="button" data-action="createSquad">Create squad</button>{{/if}}</div>
    <div class="ba-member-list">
      {{#each members}}<div class="ba-member-row" style="display:flex;align-items:center;gap:10px;min-width:0;"><i class="fa-solid fa-folder" aria-hidden="true"></i><button type="button" data-action="openMember" data-uuid="{{uuid}}" class="ba-member-name" style="flex:1;min-width:0;height:auto;white-space:normal;text-align:left;">{{name}}<small>{{count}} models</small></button>{{#if ../editable}}<button type="button" data-action="removeMember" data-uuid="{{uuid}}" class="ba-remove" style="flex:none;width:30px;" title="Unlink; Shift-click to delete" aria-label="Unlink {{name}}">×</button>{{/if}}</div>{{else}}<p>No squads assigned.</p>{{/each}}
    </div>
    {{#if editable}}<div class="ba-drop-zone" data-drop-target="squad"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i><p>Drag an existing squad here to assign it to this army.</p></div>{{/if}}
  </section>
  {{#if isGM}}<button type="button" data-action="prepareCatalogue">Prepare model compendiums</button>{{/if}}
  {{/if}}
  {{#if isSquad}}
  <div class="ba-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;">
    <label>Squad type<select data-squad-kind {{#unless editable}}disabled{{/unless}}>{{#each squadKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Experience<select data-squad-experience {{#unless editable}}disabled{{/unless}}>{{#each squadQualities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Pins<input data-pins type="number" min="0" max="100" step="1" value="{{system.pins}}" {{#unless editable}}disabled{{/unless}}></label>
  </div>
  {{#if editable}}<button type="button" data-action="rollAttack"><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll squad attack</button>{{/if}}
  {{#if incompatible}}<p class="notification warning">This squad contains incompatible model types. Remove incompatible models before adding more.</p>{{/if}}
  <section class="ba-card"><div class="ba-section-heading"><h2>Roster ({{modelCount}} models)</h2>{{#if editable}}<button type="button" data-action="addModel">Add model</button>{{/if}}</div>
    {{#if sourceProfile.baseModels}}<p>Source profile: {{sourceProfile.baseModels}} starting models{{#if sourceProfile.maxModels}}, up to {{sourceProfile.maxModels}}{{/if}}. Composition legality is not enforced.</p>{{/if}}
    <div class="ba-roster-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;">
    {{#each members}}<article class="ba-roster-card {{#if dead}}ba-casualty{{/if}}" style="display:flex;flex-direction:column;gap:8px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 40%,transparent);border-radius:6px;padding:10px;">
      <div style="display:flex;align-items:center;gap:8px;"><img src="{{img}}" alt="" width="36" height="36"><label style="flex:1;min-width:0;">Identity<input data-model-identity data-model-uuid="{{uuid}}" value="{{name}}" {{#unless ../editable}}disabled{{/unless}}></label><button type="button" data-action="openMember" data-uuid="{{uuid}}" title="Open model summary" style="width:30px;">↗</button>{{#if ../editable}}<button type="button" data-action="deleteModel" data-uuid="{{uuid}}" title="Delete model" aria-label="Delete {{name}}" style="width:30px;">×</button>{{/if}}</div>
      <small>{{type}}</small>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
      {{#if isInfantry}}<label class="ba-checkbox"><input type="checkbox" data-model-flag="isNco" data-model-uuid="{{uuid}}" {{checked isNco}} {{#unless ../editable}}disabled{{/unless}}> NCO ★</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isLoader" data-model-uuid="{{uuid}}" {{checked isLoader}} {{#unless ../editable}}disabled{{/unless}}> Loader</label><label class="ba-checkbox"><input type="checkbox" data-model-flag="isMedic" data-model-uuid="{{uuid}}" {{checked isMedic}} {{#unless ../editable}}disabled{{/unless}}> Medic</label>{{/if}}
      <label class="ba-checkbox"><input type="checkbox" data-model-flag="dead" data-model-uuid="{{uuid}}" {{checked dead}} {{#unless ../editable}}disabled{{/unless}}> Casualty</label></div>
      {{#each primarySlots}}<label>{{label}}<select data-roster-primary data-model-uuid="{{../uuid}}" {{#unless ../../editable}}disabled{{/unless}}>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/each}}
      {{#each optionalChoices}}<label class="ba-checkbox"><input type="checkbox" data-roster-option data-model-uuid="{{../uuid}}" data-choice-id="{{id}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}</label>{{/each}}
      {{#if isVehicle}}<details><summary>Vehicle status</summary><div style="display:flex;flex-wrap:wrap;gap:8px;">{{#each vehicleStates}}<label class="ba-checkbox"><input type="checkbox" data-vehicle-state="{{value}}" data-model-uuid="{{../uuid}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}</label>{{/each}}</div></details>{{/if}}
      {{#if weapons}}<small>Equipped: {{weapons}}</small>{{/if}}
      {{#if manualOptions}}<details><summary>Other profile options</summary>{{#each manualOptions}}<p>{{label}} — {{reason}}</p>{{/each}}</details>{{/if}}
    </article>{{else}}<p>No models in this squad.</p>{{/each}}</div>
    {{#if editable}}<div class="ba-drop-zone" data-drop-target="model">Drag a compendium model here to import it into this squad.</div>{{/if}}
  </section>
  {{#if sourceOptions}}<details><summary>Source profile options</summary><ul>{{#each sourceOptions}}<li>{{label}}</li>{{/each}}</ul></details>{{/if}}
  {{/if}}
  {{#if isModel}}
  <section class="ba-card"><h2>Model summary</h2><p>{{actor.name}}{{#if isNco}} · NCO ★{{/if}}{{#if isLoader}} · Loader{{/if}}{{#if system.isMedic}} · Medic{{/if}}{{#if system.dead}} · Casualty{{/if}}</p>
    {{#each weapons}}<p><strong>{{name}}</strong> · {{range}}″ · {{shots}} shots · quantity {{quantity}}</p>{{else}}<p>No weapons equipped.</p>{{/each}}
    {{#if parent}}<button type="button" data-action="openSquad">Open squad builder</button>{{else}}<p>Import or link this model into a squad to customise it.</p>{{/if}}
  </section>
  {{/if}}
  {{#if ruleProfiles}}<section class="ba-traits-card" style="padding:12px;border:1px solid color-mix(in srgb,var(--ba-faction-color) 45%,transparent);border-radius:6px;"><h2 style="font-size:1.1rem;line-height:1.3;margin:0 0 8px;">Traits</h2><div class="ba-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">{{#each ruleProfiles}}<article><h3 style="font-size:1rem;margin:0;">{{name}}</h3><small>{{source}}</small><p>{{effect}}</p>{{#if notes}}<p>{{notes}}</p>{{/if}}</article>{{/each}}</div></section>{{/if}}
  <label>Notes<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label>
</div>
