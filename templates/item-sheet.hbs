<div class="sheet-content"><header class="dossier-header"><img src="{{item.img}}" alt="" width="64" height="64"><div><span class="eyebrow">{{item.type}} profile</span><input class="name-input" name="name" value="{{item.name}}" aria-label="Name" {{#unless editable}}disabled{{/unless}}></div></header><div class="field-grid"><label>Catalogue slug<input name="system.slug" value="{{system.slug}}" {{#unless editable}}disabled{{/unless}}></label>{{#if isWeapon}}<label>Range (inches)<input name="system.range" type="number" value="{{system.range}}" {{#unless editable}}disabled{{/unless}}></label><label>Shots<input name="system.shots" type="number" value="{{system.shots}}" {{#unless editable}}disabled{{/unless}}></label><label>Penetration<input name="system.penetration" type="number" value="{{system.penetration}}" {{#unless editable}}disabled{{/unless}}></label><label>Indirect minimum range (inches)<input name="system.indirectMinRange" type="number" value="{{system.indirectMinRange}}" {{#unless editable}}disabled{{/unless}}></label><label>Indirect range (inches)<input name="system.indirectRange" type="number" value="{{system.indirectRange}}" {{#unless editable}}disabled{{/unless}}></label><label>HE diameter (inches)<input name="system.heDiameter" type="number" value="{{system.heDiameter}}" {{#unless editable}}disabled{{/unless}}></label><label>Variable shots formula<input name="system.shotsFormula" value="{{system.shotsFormula}}" {{#unless editable}}disabled{{/unless}}></label><label>Quantity<input name="system.quantity" type="number" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></label>{{/if}}{{#if isSelector}}<label>Faction UUID<input name="system.factionUuid" value="{{system.factionUuid}}" {{#unless editable}}disabled{{/unless}}></label>{{/if}}</div>{{#if isWeapon}}<details><summary>Ammunition & ranging · persistent state</summary><div class="field-grid"><label><input type="checkbox" name="system.ammoUsed" {{checked system.ammoUsed}} {{#unless editable}}disabled{{/unless}}> One-shot ammunition spent</label><label><input type="checkbox" name="system.exhausted" {{checked system.exhausted}} {{#unless editable}}disabled{{/unless}}> Fuel exhausted</label><label>Ranged target UUID<input name="system.indirectTargetUuid" value="{{system.indirectTargetUuid}}" {{#unless editable}}disabled{{/unless}}></label><label>Last ranging round<input name="system.indirectRound" type="number" value="{{system.indirectRound}}" {{#unless editable}}disabled{{/unless}}></label><label>Last hit threshold<input name="system.indirectThreshold" type="number" min="2" max="6" value="{{system.indirectThreshold}}" {{#unless editable}}disabled{{/unless}}></label><label><input type="checkbox" name="system.indirectZeroed" {{checked system.indirectZeroed}} {{#unless editable}}disabled{{/unless}}> Ranged in</label></div></details><section><div class="section-heading"><h3>Weapon traits</h3><button type="button" data-action="editTraits" {{#unless editable}}disabled{{/unless}}>Edit traits</button></div><div class="trait-list">{{#each system.traits}}<span class="trait-chip">{{this}}</span>{{else}}<span class="muted">No special traits</span>{{/each}}</div><p class="advisory">Catalogue traits are applied where supported; review special rules before resolving the attack.</p></section>{{/if}}{{#if isTrait}}<label class="notes-label">Effect<textarea name="system.effect" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.effect}}</textarea></label>{{/if}}{{#if isFaction}}<section><div class="section-heading"><h3>Faction traits</h3><button type="button" data-action="editTraits" {{#unless editable}}disabled{{/unless}}>Edit references</button></div>{{#each system.traitUuids}}<p class="muted">{{this}}</p>{{/each}}</section>{{/if}}{{#if isSelector}}<section><div class="section-heading"><h3>Selector slots</h3><button type="button" data-action="editSlots" {{#unless editable}}disabled{{/unless}}>Edit slots</button></div>{{#each system.slots}}<div class="weapon-row"><b>{{kind}}</b><span>Min {{min}}</span><span>Max {{max}}</span></div>{{/each}}</section>{{/if}}<label class="notes-label">Notes<textarea name="system.notes" rows="6" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label></div>
