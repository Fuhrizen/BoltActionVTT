<div class="boltaction ba-sheet standard-form" data-ba-sheet-root style="--ba-faction-color:{{factionColor}};display:block;padding:16px;">
<header class="ba-sheet-header"><img src="{{actor.img}}" width="48" height="48" alt=""><div class="ba-title"><small>{{kindLabel}} · {{profileName}}</small>{{#if isSquad}}<label>Identity<input name="system.identity" value="{{squadIdentity}}" {{#unless editable}}disabled{{/unless}}></label>{{else}}<h2>{{actor.name}}</h2>{{/if}}</div></header>
{{#if cost}}<p><strong>{{cost.total}} points</strong>{{#each costUnknown}} · {{this}}{{/each}}</p>{{/if}}
{{#if isTeam}}
<section class="ba-card"><h2>Army roster</h2><p>{{factionName}} · {{squadCount}} squads · {{modelCount}} models</p><p>Build your force in the standalone web builder, then import its army JSON here. Import creates a new army and preserves existing armies.</p>{{#if isGM}}<button type="button" data-action="importArmy">Import army JSON</button>{{/if}}{{#each members}}<button type="button" data-action="openMember" data-uuid="{{uuid}}">{{name}} · {{count}} models</button>{{else}}<p>No squads imported.</p>{{/each}}</section>
{{#if legality}}<details><summary>Composition review</summary>{{#if legalityPassed}}<p>No errors reported by implemented checks.</p>{{/if}}{{#each legalityErrors}}<p>{{this}}</p>{{/each}}{{#each legalityWarnings}}<p>{{this}}</p>{{/each}}</details>{{/if}}
{{/if}}
{{#if isSquad}}
<div class="ba-squad-play-bar"><label>Pins<input data-pins type="number" min="0" max="100" value="{{system.pins}}" {{#unless editable}}disabled{{/unless}}></label><div><strong>{{actionState}}</strong><small>{{system.order}} · {{experienceLabel}}</small></div>{{#if editable}}<button type="button" data-action="rollAttack">Roll dice</button>{{/if}}</div>
<details><summary>Orders and round controls</summary><button type="button" data-action="markMovement" {{#unless editable}}disabled{{/unless}}>Mark movement completed</button><button type="button" data-action="checkMorale" {{#unless editable}}disabled{{/unless}}>Morale test</button>{{#if isGM}}<button type="button" data-action="resetAction">Reset squad</button><button type="button" data-action="nextBattleRound">Next battle round</button>{{/if}}{{#each orders}}<button type="button" data-action="issueOrder" data-order="{{value}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button>{{/each}}</details>
<section class="ba-card"><h2>Models · {{modelCount}}</h2><div class="ba-roster-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;">{{#each members}}<article data-roster-card="{{uuid}}" class="ba-roster-card"><img src="{{img}}" width="40" height="40" alt=""><label>Identity<input data-model-identity data-model-uuid="{{uuid}}" value="{{name}}" {{#unless ../editable}}disabled{{/unless}}></label><small>{{weapons}}</small>{{#if isNco}}<small>★ Leader</small>{{/if}}{{#if isLoader}}<small>↔ Loader</small>{{/if}}{{#if isMedic}}<small>Medic</small>{{/if}}<label class="ba-checkbox"><input type="checkbox" data-model-flag="dead" data-model-uuid="{{uuid}}" {{checked dead}} {{#unless ../editable}}disabled{{/unless}}> Casualty</label><button type="button" data-action="openMember" data-uuid="{{uuid}}">Inspect model</button>{{#if isVehicle}}<details><summary>Vehicle states</summary>{{#each vehicleStates}}<label class="ba-checkbox"><input type="checkbox" data-vehicle-state="{{value}}" data-model-uuid="{{../uuid}}" {{checked selected}} {{#unless ../../editable}}disabled{{/unless}}> {{label}}</label>{{/each}}</details>{{/if}}{{#each weaponReferences}}<button type="button" data-action="openReference" data-uuid="{{uuid}}">{{name}} ↗</button>{{/each}}</article>{{/each}}</div></section>
{{/if}}
{{#if isModel}}<section class="ba-card"><h2>{{actor.name}}</h2>{{#each weapons}}<p>{{name}} · Range {{range}}″ · {{shots}} shots</p>{{/each}}{{#if parent}}<button type="button" data-action="openSquad">Open squad</button>{{/if}}</section>{{/if}}
{{#if ruleProfiles}}<section class="ba-traits-card"><h2>Traits</h2>{{#each ruleProfiles}}<article><strong>{{name}}</strong><small>{{source}}</small><p>{{effect}}</p>{{#if uuid}}<button type="button" data-action="openReference" data-uuid="{{uuid}}">Inspect trait</button>{{/if}}</article>{{/each}}</section>{{/if}}
<label>Notes<textarea name="system.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label>
</div>
